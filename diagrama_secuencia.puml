@startuml Diagrama de Secuencia - Ejecución del Main

title Diagrama de Secuencia - Sistema de Comercio Electrónico\nEjecución del método main()

actor Usuario
participant Main
participant DatabaseConnection <<Singleton>>
participant ProductoFactory <<Factory>>
participant Libro
participant Electronico
participant Tienda <<Observer>>
participant Cliente1 <<Observer>>
participant Cliente2 <<Observer>>
participant Cliente3 <<Observer>>
participant CarritoCompra1 <<Strategy>>
participant CarritoCompra2 <<Strategy>>
participant CarritoCompra3 <<Strategy>>
participant PagoTarjeta <<Strategy>>
participant PagoEfectivo <<Strategy>>
participant PagoPayPal <<Strategy>>

Usuario -> Main : ejecuta main()
activate Main

== 1. PATRÓN SINGLETON - Conexión a BD ==

Main -> DatabaseConnection : getInstance()
activate DatabaseConnection
DatabaseConnection -> DatabaseConnection : crear instancia (si no existe)
DatabaseConnection --> Main : db1
deactivate DatabaseConnection

Main -> DatabaseConnection : getInstance()
activate DatabaseConnection
DatabaseConnection --> Main : db2 (misma instancia)
deactivate DatabaseConnection

Main -> Main : verificar db1 == db2
Main -> DatabaseConnection : query("SELECT * FROM usuarios")
activate DatabaseConnection
DatabaseConnection --> Main : ejecuta query
deactivate DatabaseConnection

== 2. PATRÓN FACTORY - Crear Productos ==

Main -> ProductoFactory : crearLibro("Cien Años de Soledad", 25.99, "Gabriel García Márquez")
activate ProductoFactory
ProductoFactory -> Libro : new Libro(...)
activate Libro
Libro --> ProductoFactory : libro1
deactivate Libro
ProductoFactory --> Main : libro1
deactivate ProductoFactory

Main -> ProductoFactory : crearLibro("Don Quijote", 19.99, "Miguel de Cervantes")
activate ProductoFactory
ProductoFactory -> Libro : new Libro(...)
activate Libro
Libro --> ProductoFactory : libro2
deactivate Libro
ProductoFactory --> Main : libro2
deactivate ProductoFactory

Main -> ProductoFactory : crearElectronico("Laptop HP", 899.99, 24)
activate ProductoFactory
ProductoFactory -> Electronico : new Electronico(...)
activate Electronico
Electronico --> ProductoFactory : laptop
deactivate Electronico
ProductoFactory --> Main : laptop
deactivate ProductoFactory

Main -> ProductoFactory : crearElectronico("iPhone 15", 999.99, 12)
activate ProductoFactory
ProductoFactory -> Electronico : new Electronico(...)
activate Electronico
Electronico --> ProductoFactory : telefono
deactivate Electronico
ProductoFactory --> Main : telefono
deactivate ProductoFactory

Main -> Libro : mostrarInfo()
activate Libro
Libro --> Main : muestra info
deactivate Libro

Main -> Electronico : mostrarInfo()
activate Electronico
Electronico --> Main : muestra info
deactivate Electronico

== 3. PATRÓN OBSERVER - Sistema de Notificaciones ==

Main -> Tienda : new Tienda("TechStore")
activate Tienda
Tienda --> Main : tienda
deactivate Tienda

Main -> Cliente1 : new Cliente("Juan Pérez")
activate Cliente1
Cliente1 --> Main : cliente1
deactivate Cliente1

Main -> Cliente2 : new Cliente("María López")
activate Cliente2
Cliente2 --> Main : cliente2
deactivate Cliente2

Main -> Cliente3 : new Cliente("Carlos Gómez")
activate Cliente3
Cliente3 --> Main : cliente3
deactivate Cliente3

Main -> Tienda : suscribir(cliente1)
activate Tienda
Tienda -> Tienda : agregar a lista
Tienda --> Main : confirmación
deactivate Tienda

Main -> Tienda : suscribir(cliente2)
activate Tienda
Tienda -> Tienda : agregar a lista
Tienda --> Main : confirmación
deactivate Tienda

Main -> Tienda : suscribir(cliente3)
activate Tienda
Tienda -> Tienda : agregar a lista
Tienda --> Main : confirmación
deactivate Tienda

Main -> Tienda : nuevaOferta("50% descuento en laptops")
activate Tienda
Tienda -> Tienda : notificarClientes()
Tienda -> Cliente1 : actualizar("Nueva oferta: 50% descuento en laptops")
activate Cliente1
Cliente1 --> Tienda : notificación recibida
deactivate Cliente1
Tienda -> Cliente2 : actualizar("Nueva oferta: 50% descuento en laptops")
activate Cliente2
Cliente2 --> Tienda : notificación recibida
deactivate Cliente2
Tienda -> Cliente3 : actualizar("Nueva oferta: 50% descuento en laptops")
activate Cliente3
Cliente3 --> Tienda : notificación recibida
deactivate Cliente3
Tienda --> Main : todos notificados
deactivate Tienda

Main -> Tienda : desuscribir(cliente2)
activate Tienda
Tienda -> Tienda : remover de lista
Tienda --> Main : confirmación
deactivate Tienda

Main -> Tienda : nuevaOferta("Black Friday: Todo al 70% de descuento")
activate Tienda
Tienda -> Tienda : notificarClientes()
Tienda -> Cliente1 : actualizar("Nueva oferta: Black Friday...")
activate Cliente1
Cliente1 --> Tienda : notificación recibida
deactivate Cliente1
Tienda -> Cliente3 : actualizar("Nueva oferta: Black Friday...")
activate Cliente3
Cliente3 --> Tienda : notificación recibida
deactivate Cliente3
note right: Cliente2 no recibe notificación\nporque fue desuscrito
Tienda --> Main : notificados (solo 2)
deactivate Tienda

== 4. PATRÓN STRATEGY - Diferentes Formas de Pago ==

group Carrito 1 - Pago con Tarjeta
    Main -> CarritoCompra1 : new CarritoCompra()
    activate CarritoCompra1
    CarritoCompra1 --> Main : carrito1
    deactivate CarritoCompra1

    Main -> CarritoCompra1 : agregarProducto(libro1)
    activate CarritoCompra1
    CarritoCompra1 --> Main : producto agregado
    deactivate CarritoCompra1

    Main -> CarritoCompra1 : agregarProducto(laptop)
    activate CarritoCompra1
    CarritoCompra1 --> Main : producto agregado
    deactivate CarritoCompra1

    Main -> PagoTarjeta : new PagoTarjeta("4532-1234-5678-9012")
    activate PagoTarjeta
    PagoTarjeta --> Main : estrategia tarjeta
    deactivate PagoTarjeta

    Main -> CarritoCompra1 : setEstrategiaPago(pagoTarjeta)
    activate CarritoCompra1
    CarritoCompra1 --> Main : estrategia configurada
    deactivate CarritoCompra1

    Main -> CarritoCompra1 : checkout()
    activate CarritoCompra1
    CarritoCompra1 -> CarritoCompra1 : calcularTotal()
    CarritoCompra1 -> Libro : mostrarInfo()
    activate Libro
    Libro --> CarritoCompra1 : info mostrada
    deactivate Libro
    CarritoCompra1 -> Electronico : mostrarInfo()
    activate Electronico
    Electronico --> CarritoCompra1 : info mostrada
    deactivate Electronico
    CarritoCompra1 -> PagoTarjeta : pagar(925.98)
    activate PagoTarjeta
    PagoTarjeta --> CarritoCompra1 : pago procesado
    deactivate PagoTarjeta
    CarritoCompra1 --> Main : compra completada
    deactivate CarritoCompra1
end

group Carrito 2 - Pago en Efectivo
    Main -> CarritoCompra2 : new CarritoCompra()
    activate CarritoCompra2
    CarritoCompra2 --> Main : carrito2
    deactivate CarritoCompra2

    Main -> CarritoCompra2 : agregarProducto(telefono)
    activate CarritoCompra2
    CarritoCompra2 --> Main : producto agregado
    deactivate CarritoCompra2

    Main -> CarritoCompra2 : agregarProducto(libro2)
    activate CarritoCompra2
    CarritoCompra2 --> Main : producto agregado
    deactivate CarritoCompra2

    Main -> PagoEfectivo : new PagoEfectivo()
    activate PagoEfectivo
    PagoEfectivo --> Main : estrategia efectivo
    deactivate PagoEfectivo

    Main -> CarritoCompra2 : setEstrategiaPago(pagoEfectivo)
    activate CarritoCompra2
    CarritoCompra2 --> Main : estrategia configurada
    deactivate CarritoCompra2

    Main -> CarritoCompra2 : checkout()
    activate CarritoCompra2
    CarritoCompra2 -> CarritoCompra2 : calcularTotal()
    CarritoCompra2 -> Electronico : mostrarInfo()
    activate Electronico
    Electronico --> CarritoCompra2 : info mostrada
    deactivate Electronico
    CarritoCompra2 -> Libro : mostrarInfo()
    activate Libro
    Libro --> CarritoCompra2 : info mostrada
    deactivate Libro
    CarritoCompra2 -> PagoEfectivo : pagar(1019.98)
    activate PagoEfectivo
    PagoEfectivo -> PagoEfectivo : aplicar 5% descuento
    PagoEfectivo --> CarritoCompra2 : pago procesado (968.98)
    deactivate PagoEfectivo
    CarritoCompra2 --> Main : compra completada
    deactivate CarritoCompra2
end

group Carrito 3 - Pago con PayPal
    Main -> CarritoCompra3 : new CarritoCompra()
    activate CarritoCompra3
    CarritoCompra3 --> Main : carrito3
    deactivate CarritoCompra3

    Main -> CarritoCompra3 : agregarProducto(laptop)
    activate CarritoCompra3
    CarritoCompra3 --> Main : producto agregado
    deactivate CarritoCompra3

    Main -> CarritoCompra3 : agregarProducto(telefono)
    activate CarritoCompra3
    CarritoCompra3 --> Main : producto agregado
    deactivate CarritoCompra3

    Main -> PagoPayPal : new PagoPayPal("usuario@email.com")
    activate PagoPayPal
    PagoPayPal --> Main : estrategia PayPal
    deactivate PagoPayPal

    Main -> CarritoCompra3 : setEstrategiaPago(pagoPayPal)
    activate CarritoCompra3
    CarritoCompra3 --> Main : estrategia configurada
    deactivate CarritoCompra3

    Main -> CarritoCompra3 : checkout()
    activate CarritoCompra3
    CarritoCompra3 -> CarritoCompra3 : calcularTotal()
    CarritoCompra3 -> Electronico : mostrarInfo()
    activate Electronico
    Electronico --> CarritoCompra3 : info mostrada
    deactivate Electronico
    CarritoCompra3 -> Electronico : mostrarInfo()
    activate Electronico
    Electronico --> CarritoCompra3 : info mostrada
    deactivate Electronico
    CarritoCompra3 -> PagoPayPal : pagar(1899.98)
    activate PagoPayPal
    PagoPayPal --> CarritoCompra3 : pago procesado
    deactivate PagoPayPal
    CarritoCompra3 --> Main : compra completada
    deactivate CarritoCompra3
end

Main --> Usuario : fin de demostración
deactivate Main

@enduml
